PORT=3000
# Comma-separated allowed frontend origins.
CORS_ORIGIN=http://localhost:5173,https://drivego.space,https://www.drivego.space
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/DriveGo
# Required: use a strong random secret (minimum 16 chars)
JWT_SECRET=
# Firebase Admin (Google Sign-in)
FIREBASE_PROJECT_ID=
# Production-friendly option: base64 of the Firebase service account JSON.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Alternative: raw Firebase service account JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local file-path option.
GOOGLE_APPLICATION_CREDENTIALS=

# SePay — https://my.sepay.vn/webhooks
SEPAY_PAYMENT_CODE_PREFIX=DH
SEPAY_WEBHOOK_API_KEY=
# Optional alternative to API key (recommended in production)
SEPAY_WEBHOOK_HMAC_SECRET=
# Bank code used by qr.sepay.vn, for example MBBank/VCB/ACB depending on SePay docs.
SEPAY_BANK_NAME=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_HOLDER=

# Exam rules (optional — fallback to license_classes in DB)
EXAM_PASS_MIN_A1=21
EXAM_PASS_MIN_A2=21
EXAM_PASS_MIN_B1=26
EXAM_PASS_MIN_B2=26
EXAM_DURATION_MINUTES_A1=19
EXAM_DURATION_MINUTES_A2=19
EXAM_DURATION_MINUTES_B1=22
EXAM_DURATION_MINUTES_B2=22
FREE_EXAM_ATTEMPT_LIMIT=10

# Google Gemini — AI Chat (backend only, never expose in frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Uploads — local is fine for demo. In Render production, attach a persistent disk
# and set UPLOAD_DIR to that mounted path, or migrate to object storage later.
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Email — password reset
FRONTEND_URL=https://drivego.space
# Resend is preferred for deployed environments (HTTPS, no SMTP port issues).
# Verify drivego.space in Resend, then use an address on that domain.
RESEND_API_KEY=
RESEND_FROM=DriveGo <no-reply@drivego.space>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
